# MoneyPrinterTurbo secrets template.
# Copy this file to ".env" in the project root and fill in your keys.
# The .env file is gitignored and is read automatically on startup,
# overriding the matching (empty) values in config.toml.

# ---- LLM providers ----
NVIDIA_API_KEY=
# Vision model key for image/video understanding (falls back to NVIDIA_API_KEY)
VISION_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENAI_API_KEY=
POLLINATIONS_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
MODELSCOPE_API_KEY=
MINIMAX_API_KEY=
ONEAPI_API_KEY=
AZURE_API_KEY=
ERNIE_API_KEY=
ERNIE_SECRET_KEY=

# ---- Video sources (comma-separated for multiple keys) ----
PEXELS_API_KEYS=
PIXABAY_API_KEYS=

# ---- TTS / misc ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SILICONFLOW_API_KEY=
UPLOAD_POST_API_KEY=
